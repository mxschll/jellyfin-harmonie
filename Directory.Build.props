<Project>
    <PropertyGroup>
        <Version>0.1.0.0</Version>
        <AssemblyVersion>0.1.0.0</AssemblyVersion>
        <FileVersion>0.1.0.0</FileVersion>
    </PropertyGroup>

    <!--
      One Jellyfin ABI per target framework. These pins MUST exactly match
      the Jellyfin host's Directory.Packages.props for that release line;
      SkiaSharp mismatches make the plugin DLL fail to load at runtime
      (Jellyfin reports "NotSupported"). Defined once here so the plugin
      and test projects can never drift apart. DO NOT bump SkiaSharp unless
      Jellyfin itself bumps it first (Dependabot is configured to ignore it).
      Verify against the upstream release tag before changing:
      https://github.com/jellyfin/jellyfin/blob/v10.10.7/Directory.Packages.props
      https://github.com/jellyfin/jellyfin/blob/v10.11.0/Directory.Packages.props
      https://github.com/jellyfin/jellyfin/blob/v12.0-rc5/Directory.Packages.props
    -->
    <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <!-- Jellyfin 10.10.x -->
        <JellyfinVersion>10.10.7</JellyfinVersion>
        <SkiaSharpVersion>2.88.9</SkiaSharpVersion>
        <SqliteVersion>8.0.11</SqliteVersion>
    </PropertyGroup>
    <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0'">
        <!--
          Jellyfin 10.11.x. Pinned to the FLOOR of the line, not the latest
          patch: plugin assemblies compiled against a later patch (e.g.
          10.11.11) fail to load on earlier servers (e.g. 10.11.8) with
          "incompatible version of one of the shared libraries". Compiling
          against 10.11.0 loads on every 10.11.x host. API differences
          within the line are handled at runtime in JellyfinCompat.
        -->
        <JellyfinVersion>10.11.0</JellyfinVersion>
        <SkiaSharpVersion>3.116.1</SkiaSharpVersion>
        <SqliteVersion>9.0.10</SqliteVersion>
    </PropertyGroup>
    <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <!-- Jellyfin 12.x (RC) -->
        <JellyfinVersion>12.0.0-rc5</JellyfinVersion>
        <SkiaSharpVersion>3.119.4</SkiaSharpVersion>
        <SqliteVersion>10.0.10</SqliteVersion>
    </PropertyGroup>

    <!--
      Jellyfin moved these types between namespaces across ABIs. Global
      aliases keep source files free of per-file #if using blocks.
    -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <Using Include="Jellyfin.Data.Entities.User" Alias="User" />
        <Using Include="Jellyfin.Data.Enums.SortOrder" Alias="SortOrder" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' != 'net8.0'">
        <Using Include="Jellyfin.Database.Implementations.Entities.User" Alias="User" />
        <Using Include="Jellyfin.Database.Implementations.Enums.SortOrder" Alias="SortOrder" />
    </ItemGroup>
</Project>
