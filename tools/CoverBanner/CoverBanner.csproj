<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone banner generator; deliberately not part of the solution
    so it never affects plugin or CI builds. Run via
    scripts/generate-banner.sh.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../Jellyfin.Plugin.Harmonie/Jellyfin.Plugin.Harmonie.csproj" AdditionalProperties="TargetFrameworks=net10.0" />
    <!-- The plugin reference is compile-only for SkiaSharp (the Jellyfin
         host supplies it at runtime); this tool needs the real runtime.
         Keep in sync with the net10.0 pin in Directory.Build.props
         (the per-TFM props there only apply to multi-target inner
         builds, so $(SkiaSharpVersion) is empty here). -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

</Project>
